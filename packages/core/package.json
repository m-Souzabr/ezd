{
  "name": "@ezd/core",
  "version": "0.0.0",
  "private": true,
  "description": "EZDesign pure TypeScript domain: schemas, units, commands, catalog, rules, scene, bom",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@ezd/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage && vitest run --config vitest.perf.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "schema": "tsc -p tsconfig.build.json && node scripts/export-schema.mjs && node scripts/write-fixtures.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "fast-check": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "zod": "catalog:"
  }
}
