      "settings": {
        "markupBps": 2000,
        "discountBps": 500,
        "taxBps": 825,
        "currency": "USD"
      },
      "totals": {
        "subtotalCents": 81000,
        "markupCents": 16200,
        "discountCents": 4860,
        "taxableCents": 92340,
        "taxCents": 7618,
        "totalCents": 99958
      }
    },
    {
      "name": "zero rates leave the subtotal",
      "lines": [
        {
          "quantity": 1,
          "unit": "each",
          "unitPriceCents": 12345,
          "lineTotalCents": 12345
