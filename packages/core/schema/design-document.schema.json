{
  "title": "EZDesign Design Document",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,36}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "room": {
      "type": "object",
      "properties": {
        "ceilingHeight": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "walls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Wall"
          }
        },
        "openings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Opening"
          }
        }
      },
      "required": [
        "ceilingHeight",
        "walls",
        "openings"
      ],
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Item"
      }
    },
    "countertops": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/Countertop"
      }
    },
    "finishes": {
      "default": {},
      "type": "object",
      "properties": {
        "cabinet": {
          "type": "string",
          "minLength": 1
        },
        "countertop": {
          "type": "string",
          "minLength": 1
        },
        "wall": {
          "type": "string",
          "minLength": 1
        },
        "floor": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "room",
    "items"
  ],
  "additionalProperties": false,
  "$defs": {
    "Wall": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,36}$"
        },
        "start": {
          "$ref": "#/$defs/Point"
        },
        "end": {
          "$ref": "#/$defs/Point"
        },
        "thickness": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "thickness"
      ],
      "additionalProperties": false
    },
    "Point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "y": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "Opening": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,36}$"
        },
        "wallId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,36}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "door",
            "window",
            "passage"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sillHeight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "swing": {
          "type": "string",
          "enum": [
            "in-left",
            "in-right",
            "out-left",
            "out-right"
          ]
        }
      },
      "required": [
        "id",
        "wallId",
        "kind",
        "offset",
        "width",
        "height",
        "sillHeight"
      ],
      "additionalProperties": false
    },
    "Item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,36}$"
        },
        "catalogId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "base",
            "wall",
            "tall",
            "corner",
            "appliance",
            "filler",
            "panel"
          ]
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "depth": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "elevation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        },
        "options": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "finishId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "catalogId",
        "kind",
        "width",
        "height",
        "depth",
        "elevation",
        "placement",
        "options"
      ],
      "additionalProperties": false
    },
    "Placement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "wall"
            },
            "wallId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,36}$"
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "wallId",
            "offset"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "free"
            },
            "x": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "y": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "rotation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 359
            }
          },
          "required": [
            "type",
            "x",
            "y",
            "rotation"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Countertop": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,36}$"
        },
        "wallId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,36}$"
        },
        "startOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endOffset": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "depth": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "thickness": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "elevation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "finishId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "wallId",
        "startOffset",
        "endOffset",
        "depth",
        "thickness",
        "elevation"
      ],
      "additionalProperties": false
    }
  }
}
