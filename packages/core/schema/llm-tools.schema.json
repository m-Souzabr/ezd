  "tools": [
    {
      "name": "add_item",
      "description": "Add a catalog item. Put it on a wall (wall and offsetIn) or free-standing (free). Heights, depths, elevation and options default to the catalog entry. Sizes follow the catalog: cabinet widths are multiples of 3 in within the range of the entry, heights and depths are one of the standard values listed for the entry, and only fillers take an arbitrary width. Never round a size the user asked for to something else without saying so; if it is not allowed, ask with ask_user.",
      "parameters": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "catalogId": {
                "type": "string",
                "const": "base.standard"
              },
              "widthIn": {
                "type": "number",
                "minimum": 9,
                "maximum": 48,
                "multipleOf": 3
              },
              "heightIn": {
                "type": "number",
                "const": 34.5
              },
              "depthIn": {
                "type": "number",
                "const": 24
              },
              "wall": {
                "$ref": "#/$defs/WallLabel"
              },
              "offsetIn": {
                "$ref": "#/$defs/ItemOffset"
              },
              "free": {
                "$ref": "#/$defs/FreePlacement"
              },
              "elevationIn": {
                "$ref": "#/$defs/Elevation"
              },
              "options": {
                "description": "doors: 1 | 2, default 2; topDrawer: true | false, default true; hinge: left | right, default left",
                "type": "object",
                "properties": {
                  "doors": {
                    "type": "number",
                    "enum": [
                      1,
                      2
                    ]
                  },
                  "topDrawer": {
                    "type": "boolean"
                  },
