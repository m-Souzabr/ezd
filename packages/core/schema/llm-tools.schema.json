    {
      "name": "move_item",
      "description": "Move an item to another position on a wall (wall and offsetIn) or free-standing (free), optionally at another elevation.",
      "parameters": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "pattern": "^c\\d+$",
            "description": "Item alias from the design summary: c1, c2 and so on."
          },
          "wall": {
            "$ref": "#/$defs/WallLabel"
          },
          "offsetIn": {
            "$ref": "#/$defs/ItemOffset"
          },
          "free": {
            "$ref": "#/$defs/FreePlacement"
          },
          "elevationIn": {
            "$ref": "#/$defs/Elevation"
          }
        },
