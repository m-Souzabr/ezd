        "$defs": {
          "WallLabel": {
            "type": "string",
            "pattern": "^[A-Z]{1,2}$",
            "description": "Wall label from the design summary: A, B, C and so on."
          },
          "ItemOffset": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.0625,
            "description": "Left edge of the item, from the start of the wall, along it."
          },
          "FreePlacement": {
            "type": "object",
            "properties": {
              "xIn": {
                "type": "number",
                "multipleOf": 0.0625,
                "description": "Back left corner, plan x."
              },
              "yIn": {
                "type": "number",
                "multipleOf": 0.0625,
                "description": "Back left corner, plan y (y grows into the room from wall A)."
              },
              "rotation": {
                "type": "integer",
                "minimum": 0,
                "maximum": 359,
                "description": "Degrees, clockwise seen from above."
              }
            },
            "required": [
              "xIn",
              "yIn",
              "rotation"
            ],
            "additionalProperties": false,
            "description": "Free-standing placement, for islands. Give either wall and offsetIn, or free."
          },
          "Elevation": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.0625,
            "description": "Bottom of the item above the floor. Leave it out for the catalog default."
          }
        }
      }
