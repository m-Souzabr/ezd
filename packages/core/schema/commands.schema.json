{
  "title": "EZDesign Command",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Command",
  "$defs": {
    "Command": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "room.setCeilingHeight"
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "height"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "wall.add"
            },
            "wall": {
              "$ref": "#/$defs/Wall"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "wall"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "wall.update"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,36}$"
            },
            "patch": {
              "type": "object",
              "properties": {
                "start": {
                  "$ref": "#/$defs/Point"
                },
                "end": {
                  "$ref": "#/$defs/Point"
                },
                "thickness": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "height": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "id",
            "patch"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "wall.remove"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,36}$"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "opening.add"
            },
            "opening": {
              "$ref": "#/$defs/Opening"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "opening"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "opening.update"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,36}$"
            },
            "patch": {
              "type": "object",
              "properties": {
                "wallId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{8,36}$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "door",
                    "window",
                    "passage"
                  ]
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "width": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "height": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "sillHeight": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "swing": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "in-left",
                        "in-right",
                        "out-left",
                        "out-right"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "id",
            "patch"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "opening.remove"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,36}$"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "item.add"
            },
            "item": {
              "$ref": "#/$defs/Item"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "item"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "item.move"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,36}$"
            },
            "placement": {
              "$ref": "#/$defs/Placement"
            },
            "elevation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "id",
            "placement"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "item.resize"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,36}$"
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "depth": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "item.setOptions"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,36}$"
            },
            "options": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "finishId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "id",
            "options"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "item.remove"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,36}$"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "countertop.add"
            },
            "countertop": {
              "$ref": "#/$defs/Countertop"
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "countertop"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "countertop.update"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,36}$"
            },
            "patch": {
              "type": "object",
              "properties": {
                "wallId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{8,36}$"
                },
                "startOffset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "endOffset": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "depth": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "thickness": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "elevation": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "finishId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "id",
            "patch"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "countertop.remove"
            },
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,36}$"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "finish.set"
            },
            "target": {
              "type": "string",
              "enum": [
                "cabinet",
                "countertop",
                "wall",
                "floor"
              ]
            },
            "finishId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "target",
            "finishId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "document.rename"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "type",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "batch"
            },
            "commands": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Command"
              }
            },
            "label": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "commands"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Wall": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,36}$"
        },
        "start": {
          "$ref": "#/$defs/Point"
        },
        "end": {
          "$ref": "#/$defs/Point"
        },
        "thickness": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "thickness"
      ],
      "additionalProperties": false
    },
    "Point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "y": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "Opening": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,36}$"
        },
        "wallId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,36}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "door",
            "window",
            "passage"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sillHeight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "swing": {
          "type": "string",
          "enum": [
            "in-left",
            "in-right",
            "out-left",
            "out-right"
          ]
        }
      },
      "required": [
        "id",
        "wallId",
        "kind",
        "offset",
        "width",
        "height",
        "sillHeight"
      ],
      "additionalProperties": false
    },
    "Item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,36}$"
        },
        "catalogId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "base",
            "wall",
            "tall",
            "corner",
            "appliance",
            "filler",
            "panel"
          ]
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "depth": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "elevation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "placement": {
          "$ref": "#/$defs/Placement"
        },
        "options": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "finishId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "catalogId",
        "kind",
        "width",
        "height",
        "depth",
        "elevation",
        "placement",
        "options"
      ],
      "additionalProperties": false
    },
    "Placement": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "wall"
            },
            "wallId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{8,36}$"
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "wallId",
            "offset"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "free"
            },
            "x": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "y": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "rotation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 359
            }
          },
          "required": [
            "type",
            "x",
            "y",
            "rotation"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Countertop": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,36}$"
        },
        "wallId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,36}$"
        },
        "startOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endOffset": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "depth": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "thickness": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "elevation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "finishId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "wallId",
        "startOffset",
        "endOffset",
        "depth",
        "thickness",
        "elevation"
      ],
      "additionalProperties": false
    }
  }
}
