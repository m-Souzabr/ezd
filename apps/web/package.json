{
  "name": "@ezd/web",
  "version": "0.0.0",
  "private": true,
  "description": "EZDesign web app (React + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "e2e": "playwright test",
    "build": "vite build",
    "openapi": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "bundle-size": "node scripts/check-bundle.mjs",
    "perf": "playwright test -c playwright.perf.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@ezd/core": "workspace:*",
    "@hookform/resolvers": "catalog:",
    "@react-pdf/renderer": "catalog:",
    "@tanstack/react-query": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "immer": "catalog:",
    "konva": "catalog:",
    "lucide-react": "catalog:",
    "radix-ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-konva": "catalog:",
    "react-router": "catalog:",
    "roboto-fontface": "catalog:",
    "shadcn": "catalog:",
    "tw-animate-css": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "jsdom": "catalog:",
    "openapi-typescript": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
