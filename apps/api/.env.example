# Copy to apps/api/.env for local development. Read by config.settings.dev and
# config.settings.test, and by docker-compose.yml. Production sets real environment
# variables instead and uses config.settings.prod.

# Settings module: config.settings.dev | config.settings.test | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Required in prod. dev and test fall back to an insecure built-in key.
DJANGO_SECRET_KEY=change-me

# dev only (test and prod force DEBUG off)
DJANGO_DEBUG=true

# Comma-separated. Required in prod.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Required in prod. Matches the docker-compose.yml service below.
DATABASE_URL=postgres://ezd:ezd@localhost:5432/ezd

# prod only
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000

# docker-compose.yml (local PostgreSQL). Keep in sync with DATABASE_URL.
POSTGRES_DB=ezd
POSTGRES_USER=ezd
POSTGRES_PASSWORD=ezd
POSTGRES_PORT=5432
