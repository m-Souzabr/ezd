# Copy to apps/api/.env for local development. Read by config.settings.dev and
# config.settings.test, and by docker-compose.yml. Production sets real environment
# variables instead and uses config.settings.prod.

# Settings module: config.settings.dev | config.settings.test | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Required in prod. dev and test fall back to an insecure built-in key.
DJANGO_SECRET_KEY=change-me

# dev only (test and prod force DEBUG off)
DJANGO_DEBUG=true

# Comma-separated. Required in prod.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Required in prod. Matches the docker-compose.yml service below.
DATABASE_URL=postgres://ezd:ezd@localhost:5432/ezd

# Origins of the web app. dev defaults to the Vite dev server; prod has no default.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# prod only
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
# Required in prod, for the password reset email. dev prints emails to the console.
EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
# prod only. Throttle counters: per process by default, so use a shared cache when the API
# runs as several processes.
CACHE_URL=locmemcache://

# Where the web app is served. Used for the link in the password reset email.
FRONTEND_URL=http://localhost:5173
DJANGO_DEFAULT_FROM_EMAIL=EZDesign <no-reply@localhost>
DJANGO_LOG_LEVEL=INFO
# Requests per signed-in user, and how many proxies are in front of the API (the client
# address for the login throttle is read past that many).
API_THROTTLE_USER=600/min
# Sign-in, registration and password reset. The end-to-end tests raise them: every test
# signs in from the same address.
API_THROTTLE_LOGIN_IP=5/min
API_THROTTLE_LOGIN_EMAIL=5/min
API_THROTTLE_AUTH_IP=20/min
# Calls to the language model (chat, retries, photo analysis), per user.
API_THROTTLE_LLM=20/min
DJANGO_NUM_PROXIES=0

# The chat assistant. LLM_VENDOR is openai (the real model) or fake (scripted answers, for
# tests). Staff can enter the API key and the model names on the AI settings page instead;
# those take precedence. LLM_SECRET_KEY (32 bytes, base64) encrypts the stored key and is
# derived from DJANGO_SECRET_KEY when empty.
LLM_VENDOR=openai
LLM_API_KEY=
LLM_SECRET_KEY=
LLM_ROUTER_MODEL=gpt-5.4-nano
LLM_DEFAULT_MODEL=gpt-5.4-mini
LLM_ESCALATION_MODEL=gpt-5.5
LLM_TIMEOUT_SECONDS=60
LLM_MAX_MESSAGE_CHARS=2000
LLM_MAX_SUMMARY_CHARS=12000
LLM_MAX_OUTPUT_TOKENS=4000
LLM_MONTHLY_TOKEN_QUOTA=2000000
LLM_HISTORY_TURNS=6

# Photo import. LLM_MODEL_VISION reads the photos; empty means the chat's default model.
# Analysis runs inside the request, up to three attempts of LLM_PHOTO_TIMEOUT_SECONDS each.
LLM_MODEL_VISION=
LLM_PHOTO_TIMEOUT_SECONDS=180
LLM_PHOTO_MAX_OUTPUT_TOKENS=8000
PHOTO_MAX_BYTES=10485760
PHOTO_MAX_PIXELS=50000000
PHOTO_MAX_EDGE=2000

# Where uploaded photos are kept: filesystem (MEDIA_ROOT) or s3 (a private S3-compatible
# bucket). Photos are only ever served through the API, to their owner.
STORAGE_BACKEND=filesystem
MEDIA_ROOT=
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Set by the API image. In a checkout, leave them unset: they default to the files under
# packages/. EZD_CORE_CLI is a comma-separated command.
# DESIGN_DOCUMENT_SCHEMA_PATH=/opt/ezd/design-document.schema.json
# EZD_CORE_CLI=node,/opt/ezd/cli.js
# LLM_TOOLS_SCHEMA_PATH=/opt/ezd/llm-tools.schema.json
# LLM_CATALOG_INDEX_PATH=/opt/ezd/llm-catalog-index.txt
# DRAFT_ROOM_SCHEMA_PATH=/opt/ezd/draft-room.schema.json
# ROOM_DRAFT_SCHEMA_PATH=/opt/ezd/room-draft.schema.json

# docker-compose.yml (local PostgreSQL). Keep in sync with DATABASE_URL.
POSTGRES_DB=ezd
POSTGRES_USER=ezd
POSTGRES_PASSWORD=ezd
POSTGRES_PORT=5432
# docker-compose.yml, `--profile api` only
API_PORT=8000

# A dotted path to a function(error, context) that reports unexpected errors, or empty.
ERROR_REPORTER=
