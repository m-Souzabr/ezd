{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile",
    "watchPatterns": ["apps/api/**", "packages/core/**", "packages/core-cli/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE"
  }
}
